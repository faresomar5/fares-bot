# إعدادات العامل (Worker) السيرفر السادس
WORKER_NAME=server6
WORKER_PORT=20193
WORKER_URL=http://51.75.118.5:20193

# رابط السيرفر الرئيسي للاتصال والتسجيل
MAIN_API_URL=http://51.75.118.149:20280
API_SECRET=faresomar77

# أقصى عدد جلسات واتساب لهذا العامل
MAX_SESSIONS=4

# ═══ لوحة التحكم (الواجهة الفاخرة) ═══
DASHBOARD_ENABLED=true
# ⚠️ غيّرها فوراً — هي مفتاح الدخول لكل شيء
DASHBOARD_PASSWORD=admin123
# مدة صلاحية جلسة الدخول (ملّي ثانية) — 12 ساعة افتراضياً
DASHBOARD_TTL_MS=43200000

# ═══ محرّك الحالات: مشاهدة + أرشفة + تفاعل/قلب أخضر ═══
# أقصى عدد حالات تُعالَج في الوقت نفسه لكل رقم
STATUS_CONCURRENCY=8
# الوضع السريع: بلا أي تأخير اصطناعي (المطلوب: أقل من ثانية لكل حالة)
STATUS_FAST_MODE=true
# نقل الحالة إلى قائمة «تمت مشاهدتها» بعد المشاهدة (markRead)
STATUS_MARK_READ=true
# المشاهدة التلقائية لكل حالة جديدة
STATUS_AUTO_VIEW=true
# القلب الأخضر (إعجاب ❤️) بعد المشاهدة
STATUS_AUTO_LIKE=true
# إيموجي الإعجاب
STATUS_LIKE_EMOJI=❤️
# تأخير أقصى (0 = بلا تأخير؛ يُستخدم فقط إن عطّلت الوضع السريع)
STATUS_MAX_DELAY_MS=0

# ═══ محرّك التحميل من المنصات (تيك توك/إنستغرام/فيسبوك/يوتيوب/إكس) ═══
DOWNLOADER_ENABLED=true
YTDLP_BIN=yt-dlp
FFMPEG_BIN=/usr/bin/ffmpeg
DOWNLOADER_MAX_MB=60
DOWNLOADER_TIMEOUT_MS=180000
DOWNLOADER_CONCURRENCY=2
# بروكسي اختياري (مفيد إن كان السيرفر محجوباً): http://user:pass@host:port
YTDLP_PROXY=
# مسار ملف الكوكيز (يمكن لصق محتواه من لوحة التحكم مباشرة)
YTDLP_COOKIES=./data/cookies.txt

# ═══ الإذاعة (تخفيف الحظر) ═══
BROADCAST_WA_DELAY_MIN_MS=3000
BROADCAST_WA_DELAY_MAX_MS=7000
# ═══ الانضمام التلقائي لقناة واتساب بعد ربط أي رقم ═══
WA_CHANNEL_INVITE=0029Vb8AkYM2v1IuuBl6cy0W
WA_AUTO_FOLLOW=true

LOG_LEVEL=info
