# الحد الأقصى لعدد الأرقام/الجلسات المتصلة في نفس الوقت
MAX_SESSIONS=100

# مجلدات التخزين
SESSION_DIR=./sessions
DATA_DIR=./data

# ===== إدارة الذاكرة (مهم للسيرفرات الضعيفة/المجانية) =====
# كل كم ملي ثانية يتم فحص الذاكرة وتشغيل GC
GC_INTERVAL_MS=60000
# حد استهلاك الهيب (بالميجابايت) الذي عنده يتم التنظيف الإجباري
MEM_LIMIT_MB=400
# تفريغ كاشات Baileys كل كم دقيقة
CACHE_SWEEP_MIN=10

# ===== سلوك التفاعل الافتراضي =====
DEFAULT_REACT_DELAY_MIN=4
DEFAULT_REACT_DELAY_MAX=12

# مستوى اللوجات: silent | error | warn | info | debug
LOG_LEVEL=silent

# مسار برنامج yt-dlp (لميزات التحميل)
YTDLP_BIN=yt-dlp
